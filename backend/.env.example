# AI Provider API Keys (set the one you're using)
# Gemini is recommended for free demo usage

# Google Gemini (FREE tier: 15 requests/min)
GEMINI_API_KEY=your_gemini_api_key_here

# OpenAI GPT-4 Vision
OPENAI_API_KEY=your_openai_api_key_here

# Meta Llama API
LLAMA_API_KEY=your_llama_api_key_here

# xAI Grok
GROK_API_KEY=your_grok_api_key_here

# Database URL (PostgreSQL recommended)
DATABASE_URL=postgresql://user:password@localhost:5432/cctv_events
